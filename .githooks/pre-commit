#!/bin/bash
# Runs before every commit (install once with scripts/install-hooks.sh): the secret scan, then the check that
# changed code has passed its tests as it is now (scripts/agent/check-commit.sh).
root="$(git rev-parse --show-toplevel)"
"$root/scripts/check-secrets.sh" --staged || exit 1
exec "$root/scripts/agent/check-commit.sh"
